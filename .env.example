# Database (PostgreSQL / Neon)
DATABASE_URL=

# Auth.js v5
# Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
# The canonical deployed URL of this app (also used to build links in emails).
AUTH_URL=http://localhost:3000

# Google OAuth ("Continue with Google")
# 1. console.cloud.google.com -> OAuth consent screen (External; while in
#    "Testing" status only added test-user emails can sign in — publish it
#    to allow any Google account).
# 2. console.cloud.google.com -> Credentials -> Create Credentials -> OAuth
#    client ID -> Web application.
# 3. Add ONE Authorized redirect URI per environment to that SAME client:
#      http://localhost:3000/api/auth/callback/google         (local dev)
#      https://<your-production-domain>/api/auth/callback/google  (prod —
#        this app's real deployed domain, i.e. wherever /login and /admin
#        actually resolve in production, not necessarily this repo's
#        marketing-site URL if they're ever split apart)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel Blob (file storage)
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Transactional email (Resend)
# 1. resend.com -> Domains -> Add Domain -> add the SPF/DKIM/(DMARC) DNS
#    records it gives you at your DNS provider -> Verify.
# 2. resend.com/api-keys -> Create API Key ("Sending access" scope is enough).
RESEND_API_KEY=
# The domain after @ MUST exactly match a domain verified in step 1 above,
# or Resend will reject the send. Falls back to Resend's shared
# onboarding@resend.dev sender (severely rate-limited, testing only) if unset.
EMAIL_FROM="TechParivar <notifications@techparivar.com>"
# Where new-support-ticket notifications are sent. If unset, ticket creation
# still succeeds but the notification is skipped (logged as a warning).
ADMIN_NOTIFICATION_EMAIL=
